# VortExec — environment variables
#
# Copy this file to .env and fill in real values.
# Never commit .env to git. Real secrets only go in environment variables,
# never in the YAML config files.

# Which config environment to load (dev, prod). Defaults to "dev" if unset.
VORTEXEC_ENV=dev

# Logging level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
VORTEXEC_LOG_LEVEL=INFO

# HTTP server bind address. Defaults to 0.0.0.0:8000.
VORTEXEC_HTTP_HOST=0.0.0.0
VORTEXEC_HTTP_PORT=8000

# Where to write recorded market data. Defaults to ./data/recordings.
VORTEXEC_DATA_DIR=./data/recordings

# Path to the trained model file. Defaults to ./data/models/quantile_v1.pkl.
VORTEXEC_MODEL_PATH=./data/models/quantile_v1.pkl

# SQLite database for auth and billing. Defaults to ./data/auth.db.
VORTEXEC_AUTH_DB=./data/auth.db

# Stripe — test keys for development, live keys only in production .env
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Exchange API credentials (only needed for authenticated endpoints,
# not for public market data). Leave blank for now.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
