# VortExec service configuration. Copied to /etc/vortexec/env on the VPS.
# Edit before starting the service for the first time.

# ─── Required ─────────────────────────────────────────────────────────────────

# Space-separated list of symbols to maintain.
VORTEXEC_SYMBOLS="BTCUSDT ETHUSDT SOLUSDT"

# Where Parquet recordings land. Mount the block-storage volume here.
VORTEXEC_DATA_DIR=/var/lib/vortexec/data

# ─── Recording cadence ────────────────────────────────────────────────────────

# Seconds between full-book snapshots (10 min default).
VORTEXEC_SNAPSHOT_INTERVAL=600

# ─── Liveness monitoring ──────────────────────────────────────────────────────

# Healthchecks.io URL. Service GETs this every 60s; alert fires if no ping
# within the configured grace period. Leave empty to disable.
VORTEXEC_HEALTHCHECKS_URL=

# Separate Healthchecks.io URL for the daily diff-count cron. Empty to disable.
VORTEXEC_DIFFCOUNT_HC_URL=

# Minimum diffs per symbol per day before the daily check fires an alert.
# Real traffic is ~1-10M diffs/day depending on symbol. 100k is a safe floor
# that only triggers on actual breakage.
VORTEXEC_MIN_DIFFS_PER_SYMBOL_DAY=100000

# ─── Cloudflare R2 backup (used by deploy/backup.sh) ──────────────────────────

R2_BUCKET=vortexec-backup
R2_PREFIX=production
